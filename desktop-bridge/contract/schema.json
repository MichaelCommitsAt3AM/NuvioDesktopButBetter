            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "background": {
                "type": "string"
              },
              "accent": {
                "type": "string"
              },
              "surface": {
                "type": "string"
              },
              "settingsSurface": {
                "type": "string"
              }
            }
          }
        }
      }
