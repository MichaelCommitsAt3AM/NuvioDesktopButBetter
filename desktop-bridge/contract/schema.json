        "playable": {
          "type": "boolean"
        },
        "downloadable": {
          "type": "boolean"
        },
        "presentation": {
          "type": "object"
        }
      }
    },
    "Streams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "loading",
        "error",
        "groups"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "loading",
              "error",
              "streams"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "loading": {
                "type": "boolean"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "streams": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Stream"
                }
              }
            }
          }
        }
      }
    },
    "BridgeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
