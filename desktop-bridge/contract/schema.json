{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvio.local/desktop/contract/v1",
  "title": "Nuvio Desktop Bridge Protocol v1",
  "description": "Stable fork-owned boundary. Upstream repository models are mapped explicitly in Kotlin adapters.",
  "$defs": {
    "Addons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Addon"
          }
        }
      }
    },
    "Media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "poster",
        "background",
        "logo",
        "description",
        "releaseInfo",
        "rating",
        "genres"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "poster": {
          "type": [
            "string",
            "null"
          ]
        },
        "background": {
          "type": [
            "string",
            "null"
          ]
        },
        "logo": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "releaseInfo": {
          "type": [
            "string",
            "null"
          ]
        },
        "rating": {
          "type": [
            "string",
            "null"
          ]
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Shelf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "subtitle",
        "items",
        "hasMore"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Media"
          }
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "Home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loading",
        "error",
        "hero",
        "shelves"
      ],
      "properties": {
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "hero": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Media"
          }
        },
        "shelves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Shelf"
          }
        },
        "continueWatching": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Media"
          }
        }
      }
    },
    "Library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loading",
        "error",
        "items"
      ],
      "properties": {
        "loading": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Media"
          }
        }
      }
    },
    "Addon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "manifestUrl",
        "enabled",
        "description",
        "logo"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "manifestUrl": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "logo": {
          "type": [
            "string",
            "null"
          ]
        },
        "refreshing": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "configurable": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "types",
              "idPrefixes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "idPrefixes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "catalogCount": {
          "type": "integer",
          "minimum": 0
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "avatarUrl",
        "color",
        "locked"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "avatarUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "email",
        "version",
        "activeProfile",
        "profiles",
        "capabilities",
        "error"
      ],
      "properties": {
        "networkCondition": {
          "enum": ["Unknown", "Checking", "Online", "NoInternet", "ServersUnreachable"]
        },
        "status": {
          "enum": [
            "loading",
            "signedOut",
            "signedIn"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        },
        "activeProfile": {
          "type": [
            "integer",
            "null"
          ]
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Profile"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
