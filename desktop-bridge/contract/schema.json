            "properties": {
              "name": {
                "type": "string"
              },
              "photo": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Media"
          }
        }
      }
